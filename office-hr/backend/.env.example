# copy to .env and fill in
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://office:office@localhost:5432/office_hr

# long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# the React app (used for CORS and links in emails)
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
UPLOAD_DIR=uploads

# office timezone: decides what "today" is (reports, leave, attendance)
APP_TIMEZONE=Australia/Sydney

# SMTP — leave SMTP_HOST empty in development: emails are printed to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Office HR <no-reply@example.com>"
HR_INBOX=
